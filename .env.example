DISCORD_TOKEN=your_discord_bot_token
NVIDIA_API_KEY=your_nvidia_api_key
# Optional: defaults to nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional: limit chat, /ask, and !reset to one channel (blank allows all channels)
ALLOWED_CHANNEL_ID=
# Optional: API request timeout in seconds (default: 120)
NVIDIA_TIMEOUT_SECONDS=120
# Optional: set to a writable persistent-volume path on your hosting provider
# CHAT_HISTORY_DB=/persistent/chat_history.db
# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO