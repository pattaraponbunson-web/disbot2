DISCORD_TOKEN=your_discord_bot_token
NVIDIA_API_KEY=your_nvidia_api_key
# Optional: defaults to deepseek-ai/deepseek-v4.1-flash
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# Optional: set to a writable persistent-volume path on your hosting provider
# CHAT_HISTORY_DB=/persistent/chat_history.db
# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO